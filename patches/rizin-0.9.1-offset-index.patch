 /* \brief unset the all flag items found at offset \p off.
  *
  * return true if at least one flag is found and unset, false otherwise.
  */
 RZ_API bool rz_flag_unset_all_off(RzFlag *f, ut64 off) {
 	rz_return_val_if_fail(f, false);
