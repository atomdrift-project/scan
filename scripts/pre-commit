#!/bin/sh
# Pre-commit gate for atomdrift-scan. Install with `make install-precommit`.
#
# Refuses the commit unless:
#   1. scripts/check-lock.sh finds no local path override in Cargo.toml,
#      .cargo/config.toml or Cargo.lock. These build against an unpublished
#      local crate and must never be committed.
#   2. `make test` passes.
#   3. `make lint` passes (clippy with -D warnings).
#   4. `atomscan validate` exits cleanly (model loads and benign fixtures stay benign).
#
# Test runs BEFORE lint on purpose: `cargo test` fully builds the dependency
# tree (rlibs), which clippy then reuses, so `make lint` re-checks only scan
# itself. Lint-first throws that away — clippy's metadata-only pass produces
# nothing `cargo test` can build on, and the dep tree gets paid for twice.
#
# Bypass intentionally with `git commit --no-verify`.

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! scripts/check-lock.sh; then
	echo "pre-commit: refusing commit — local dependency override (shown above)." >&2
	echo "Remove it before committing, or bypass with: git commit --no-verify" >&2
	exit 1
fi

echo "pre-commit: running make test..."
make test

echo "pre-commit: running make lint..."
make lint

# 4. Build the CLI and run `atomscan validate`. This loads the deployed model and
# verifies the benign fixtures stay benign — a degraded or drifted bundle, or a
# feature-extraction regression, must not slip through. set -e aborts the commit
# on a non-zero exit.
echo "pre-commit: building atomscan..."
cargo build --bin atomscan

echo "pre-commit: running atomscan validate..."
target/debug/atomscan validate

echo "pre-commit: all checks passed."
